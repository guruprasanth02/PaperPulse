# Google Gemini API Key (Scoped to gemini-3.5-flash-lite / gemini-3.5-flash)
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Backend API URL (Optional in production: defaults to /api on Vercel or http://localhost:8000 in dev)
# VITE_API_URL=https://your-backend-domain.com

# Firebase Authentication (Optional - guest mode available if omitted)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
